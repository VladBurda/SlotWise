SLOTWISE_ENVIRONMENT=development
SLOTWISE_DATABASE_URL=postgresql+asyncpg://slotwise:slotwise_local@localhost:5432/slotwise
SLOTWISE_REDIS_URL=redis://localhost:6379/0
SLOTWISE_CORS_ORIGINS=["http://localhost:5173"]
