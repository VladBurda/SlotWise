SLOTWISE_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SLOTWISE_SMTP_HOST=localhost
SLOTWISE_SMTP_PORT=1025
SLOTWISE_MAIL_WORKER_ENABLED=true
# Set a random >=32-character SLOTWISE_MAIL_SECRET and HTTPS URLs in production.
